# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Datalk

# Canonical production URL (no trailing slash). Used for canonical tags,
# sitemap.xml, robots.txt, and Open Graph/Twitter card URLs. Must match the
# exact domain + protocol verified in Google Search Console.
NEXT_PUBLIC_SITE_URL=https://datalk.co.in

# ─── Custom JWT (used for email/password login) ───────────────────────────────
JWT_SECRET=change-me-in-production

# ─── Backend services ────────────────────────────────────────────────────────
INGESTION_API_BASE_URL=http://localhost:8000/api/v1
CHAT_API_BASE_URL=http://localhost:8001/api/v1

# Datalk Chat Service host serving the embed endpoints (/chat/api/v1/embed/*).
# Defaults to CHAT_API_BASE_URL when unset.
EMBED_BASE_URL=http://localhost:8001

# ─── Amazon Cognito ───────────────────────────────────────────────────────────
# Your Cognito Hosted UI domain (without https://)
# e.g. datalk.auth.us-east-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_DOMAIN=

# User Pool ID (e.g. us-east-1_XXXXXXXXX)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=

# App Client ID (public)
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=

# App Client Secret (server-side only – keep private, do NOT prefix with NEXT_PUBLIC_)
COGNITO_CLIENT_SECRET=

# OAuth callback URL registered in the Cognito App Client
NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_IN=http://localhost:3000/api/auth/callback

# Logout redirect URL registered in the Cognito App Client
NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_OUT=http://localhost:3000/login
