JWT_SECRET="change-me-to-the-same-secret-used-by-your-backends"
INGESTION_API_BASE_URL="http://localhost:8000/api/v1"
CHAT_API_BASE_URL="http://localhost:8001/api/v1"
EMBED_BASE_URL="http://localhost:8001"
NEXT_PUBLIC_APP_NAME="Datalk"
# Admin panel (/admin) credentials — used only until you change them from the
# panel's Settings tab (which writes .data/admin.json overrides). The dev
# default is admin / admin — set these before going live!
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin"
# Canonical production URL — used for canonical tags, sitemap.xml, robots.txt,
# and Open Graph/Twitter card URLs. Must be absolute, include https://, and
# match the domain Search Console is verified against (no trailing slash).
NEXT_PUBLIC_SITE_URL="https://datalk.co.in"
NODE_ENV="development"
